cmd_server() {
    local sub="${1:-status}"
    shift 2>/dev/null || true
    case "$sub" in
        status)
            bash "$PZ_ROOT/linux/server/llm-server.sh" status
            bash "$PZ_ROOT/linux/server/homelab-stack.sh" status
            bash "$PZ_ROOT/linux/server/casaos.sh" status
            bash "$PZ_ROOT/linux/server/install-homelab-boot.sh" status
            ;;
        llm)      bash "$PZ_ROOT/linux/server/llm-server.sh" "${1:-status}" "${@:2}" ;;
        homelab)
            local host_alias=""
            local -a hl_args=()
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --host)
                        [ "${2:-}" ] || { pz_error "--host requires alias"; return 2; }
                        host_alias="$2"
                        shift 2
                        ;;
                    --host=*)
                        host_alias="${1#--host=}"
                        shift
                        ;;
                    *)
                        hl_args+=("$1")
                        shift
                        ;;
                esac
            done
            if [ -n "$host_alias" ]; then
                case "${hl_args[0]:-}" in
                    hosts)
                        pz_error "hosts registry is local; do not combine --host with hosts"
                        return 2
                        ;;
                esac
                bash "$PZ_ROOT/linux/server/homelab-hosts.sh" exec "$host_alias" -- "${hl_args[@]}"
                return
            fi
            set -- "${hl_args[@]}"
            case "${1:-status}" in
                status|verify|repair) bash "$PZ_ROOT/linux/server/homelab-status.sh" "$@" ;;
                profiles) bash "$PZ_ROOT/linux/server/homelab-governor.sh" list ;;
                profile)
                    case "${2:-list}" in
                        list) bash "$PZ_ROOT/linux/server/homelab-governor.sh" list ;;
                        set)
                            [ "${3:-}" ] || { echo "usage: pz server homelab profile set <key>" >&2; exit 2; }
                            if ! bash "$PZ_ROOT/linux/server/homelab-governor.sh" list 2>/dev/null | jq -e '[.profiles[].key] | index("'"$3"'") != null' >/dev/null; then
                                echo "unknown homelab profile: $3" >&2
                                exit 2
                            fi
                            HL_STATE="${PZ_HOMELAB_STATE:-$PZ_STATE/homelab}"
                            mkdir -p "$HL_STATE"
                            printf '%s\n' "$3" > "$HL_STATE/profile.active"
                            echo "homelab profile set: $3"
                            ;;
                        get) cat "${PZ_HOMELAB_STATE:-$PZ_STATE/homelab}/profile.active" 2>/dev/null || echo "unset" ;;
                        *) echo "usage: pz server homelab profile (list|set <key>|get)" >&2; exit 2 ;;
                    esac
                    ;;
                governor) bash "$PZ_ROOT/linux/server/homelab-governor.sh" "${2:-list}" "${@:3}" ;;
                apps) bash "$PZ_ROOT/linux/server/homelab-apps.sh" "${@:2}" ;;
                hosts) bash "$PZ_ROOT/linux/server/homelab-hosts.sh" "${@:2}" ;;
                agent) python3 "$PZ_ROOT/linux/server/homelab_agent.py" "${@:2}" ;;
                discover) python3 "$PZ_ROOT/linux/server/homelab_agent.py" discover --json ;;
                web) python3 "$PZ_ROOT/linux/server/homelab_web.py" "${@:2}" ;;
                host-facts) bash "$PZ_ROOT/linux/server/homelab-host-facts.sh" "${@:2}" ;;
                *) bash "$PZ_ROOT/linux/server/homelab-stack.sh" "$@" ;;
            esac
            ;;
        casaos)   bash "$PZ_ROOT/linux/server/casaos.sh" "${1:-status}" "${@:2}" ;;
        up)       bash "$PZ_ROOT/linux/server/homelab-stack.sh" up "$@" ;;
        down)     bash "$PZ_ROOT/linux/server/homelab-stack.sh" down ;;
        hermes)   bash "$PZ_ROOT/linux/server/hermes-remote.sh" "${1:-status}" "${@:2}" ;;
        slim)     bash "$PZ_ROOT/linux/server/os-slim.sh" "${1:-status}" "${@:2}" ;;
        boot)     bash "$PZ_ROOT/linux/server/install-homelab-boot.sh" "${1:-status}" "${@:2}" ;;
        *) pz_error "usage: pz server (status|llm|homelab|casaos|up|down|hermes|slim|boot) ..."; return 1 ;;
    esac
}

