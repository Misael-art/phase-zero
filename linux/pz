cmd_doctor() {
    # Global watchdog: per-check timeouts bound every subcommand (doctor.sh),
    # this caps the whole run. Override with PZ_DOCTOR_TIMEOUT (seconds).
    local scope="full" json=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --scope)
                case "${2:-}" in
                    system|full) scope="$2"; shift 2 ;;
                    *) pz_error "usage: pz doctor [--scope system|full] [--json]"; return 1 ;;
                esac
                ;;
            --json) json=1; shift ;;
            # Flag desconhecida era ignorada em silêncio: quem pedia --json
            # recebia o relatório humano e nenhum aviso.
            *) pz_error "usage: pz doctor [--scope system|full] [--json]"; return 1 ;;
        esac
    done
    if [ "$json" = 1 ]; then
        # fd 3 = stdout de verdade (só o envelope); stdout do script = lixeira.
        PZ_DOCTOR_SCOPE="$scope" PZ_DOCTOR_JSON=1 \
            timeout "${PZ_DOCTOR_TIMEOUT:-300}" bash "$PZ_ROOT/linux/audit/doctor.sh" \
            3>&1 1>/dev/null
        return $?
    fi
    PZ_DOCTOR_SCOPE="$scope" PZ_DOCTOR_JSON=0 \
        timeout "${PZ_DOCTOR_TIMEOUT:-300}" bash "$PZ_ROOT/linux/audit/doctor.sh"
}

cmd_support_bundle() {
    case "${1:-collect}" in
        collect|"") bash "$PZ_ROOT/linux/audit/support-bundle.sh" ;;
        --plan)     bash "$PZ_ROOT/linux/audit/support-bundle.sh" --plan ;;
        *)          pz_error "usage: pz support-bundle [--plan]"; return 1 ;;
    esac
}

cmd_repair_plan() {
    bash "$PZ_ROOT/linux/audit/repair-plan.sh"
}

cmd_tune() {
    local area="${1:-}" usage="usage: pz tune (browser|gaming|dev) [apply|revert|status] [--dry-run]"
    [ -z "$area" ] && { pz_error "$usage"; return 1; }
    shift
    local -a args=()
    local token
    for token in "$@"; do
        case "$token" in
            apply|revert|status|--dry-run) args+=("$token") ;;
            "") ;;
            *) pz_error "$usage"; return 1 ;;
        esac
    done
    [ "${#args[@]}" -gt 0 ] || args=(apply)
    local script
    case "$area" in
        browser) script="browser-hardening.sh" ;;
        gaming)  script="gaming-tweaks.sh" ;;
        dev)     script="dev-tweaks.sh" ;;
        *)       pz_error "unknown tune area: $area"; return 1 ;;
    esac
    bash "$PZ_ROOT/linux/tuning/$script" "${args[@]}"
}

cmd_ui() {
    local action="${1:-native}" port="${2:-auto}"
    local -a port_args=()
    case "$action" in
        native|app|desktop|"")
            bash "$PZ_ROOT/linux/ui/native.sh" "${@:2}"
            ;;
        server)
            ui_regenerate_allowlist
            if [ "$port" != "auto" ]; then
                pz_validate_tcp_port "$port" || return
                port_args=(--port "$port")
            fi
            python3 "$PZ_ROOT/linux/ui/server.py" "${port_args[@]}"
            ;;
        tui)
            ui_regenerate_allowlist
            bash "$PZ_ROOT/linux/ui/tui.sh"
            ;;
        status)
            local pid_file="$PZ_STATE/ui-server.pid" server_pid=""
            # Best-effort read: a missing or unreadable pid file just leaves
            # server_pid empty, which the validation below already treats as
            # "not running".
            if [ -f "$pid_file" ]; then
                IFS= read -r server_pid < "$pid_file" || server_pid=""
            fi
            if [[ "$server_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$server_pid" 2>/dev/null; then
                echo "UI server running (pid $server_pid)"
            else
                echo "UI server not running"
            fi
            ;;
        menu)
            PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
                python3 "$PZ_ROOT/linux/ui/menu.py" "${2:-scan}" "${@:3}"
            ;;
        web|open)
            # start server in background and open browser
            local log_file="$PZ_STATE/ui-server.log"
            local web_port="$port"
            local token_file="$PZ_STATE/ui-token" ui_token="" attempt
            [ "$web_port" = "auto" ] && web_port=8080
            pz_validate_tcp_port "$web_port" || return
            mkdir -p "$PZ_STATE"
            ui_regenerate_allowlist
            python3 "$PZ_ROOT/linux/ui/server.py" --port "$web_port" --daemon "$log_file" &
            local pid=$!
            echo "$pid" > "$PZ_STATE/ui-server.pid"
            for ((attempt = 0; attempt < 50; attempt++)); do
                if ! kill -0 "$pid" 2>/dev/null; then
                    break
                fi
                if ui_token="$(pz_read_ui_token "$token_file" 2>/dev/null)" &&
                    pz_ui_server_ready "$web_port" "$token_file"; then
                    break
                fi
                sleep 0.1
            done
            if [ -z "$ui_token" ]; then
                kill "$pid" 2>/dev/null || true
                wait "$pid" 2>/dev/null || true
                rm -f -- "$PZ_STATE/ui-server.pid"
                pz_error "UI server did not create a valid private token; log: $log_file"
                return 1
            fi
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "http://127.0.0.1:$web_port/?token=$ui_token" 2>/dev/null ||
                    pz_warn "browser opener failed; server remains available on loopback"
            else
                pz_warn "xdg-open missing; server remains available on loopback"
            fi
            ui_token=""
            echo "Dashboard: http://127.0.0.1:$web_port (pid $pid)"
            ;;
        *)
            pz_error "usage: pz ui (native|web|server|tui|status|menu <scan|plan|apply|sync|rollback>)"
            return 1
            ;;
    esac
}

pz_validate_tcp_port() {
    local port="${1:-}"
    if [[ ! "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        pz_error "invalid TCP port: ${port:-empty} (expected 1..65535)"
        return 2
    fi
}

pz_read_ui_token() {
    local path="$1" token mode
    [ -f "$path" ] && [ ! -L "$path" ] && [ -O "$path" ] || return 1
    mode="$(stat -c '%a' "$path" 2>/dev/null || true)"
    [ "$mode" = "600" ] || return 1
    IFS= read -r token < "$path" || true
    [[ "$token" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$token"
}

pz_ui_server_ready() {
    local port="$1" token_file="$2"
    python3 - "$port" "$token_file" <<'PY' >/dev/null 2>&1
import http.client
import json
import pathlib
import sys

port = int(sys.argv[1])
token = pathlib.Path(sys.argv[2]).read_text(encoding="ascii").strip()
connection = http.client.HTTPConnection("127.0.0.1", port, timeout=0.25)
try:
    connection.request("GET", "/api/token-status", headers={"Authorization": f"Bearer {token}"})
    response = connection.getresponse()
    payload = json.loads(response.read())
    if response.status != 200 or payload.get("valid") is not True:
        raise SystemExit(1)
finally:
    connection.close()
PY
}

ui_regenerate_allowlist() {
    # Refresh the web/TUI allowlist snapshot from the live native catalog so the
    # fallback (used when catalog.py cannot be imported at server runtime) also
    # exposes every implemented function. Best-effort: failures are non-fatal.
    local destination="${XDG_STATE_HOME:-$HOME/.local/state}/phasezero/ui-actions.json"
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.ui.generate_actions --root "$PZ_ROOT" "$destination" >/dev/null 2>&1 || true
}

cmd_commands() {
    local format="${1:---json}"
    [ "$format" = "--json" ] || {
        pz_error "usage: pz commands --json"
        return 2
    }
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PZ_ROOT" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
from linux.ui_native.catalog import catalog_manifest

print(json.dumps(catalog_manifest(root), ensure_ascii=False, indent=2))
PY
}

cmd_capabilities() {
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.capabilities "$@"
}

cmd_themes() {
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.themes "$@"
}

cmd_deps() {
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.deps "$@"
}

cmd_installation() {
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.installation "$@"
}

cmd_self_update() {
    PYTHONPATH="$PZ_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -m linux.installation.update_cli "$@"
}

cmd_updates() {
    bash "$PZ_ROOT/linux/updates/app-updates.sh" "$@"
}

cmd_host() {
    bash "$PZ_ROOT/linux/host.sh" "$@"
}

main() {
    local cmd="${1:-help}"
    shift 2>/dev/null || true
    case "$cmd" in
        install)       cmd_install "$@" ;;
        steamdeck)     cmd_steamdeck "$@" ;;
        flatpak)       cmd_flatpak "$@" ;;
        windows-vm|windows|winvm|win-vm) cmd_windows_vm "$@" ;;
        waydroid|android) cmd_waydroid "$@" ;;
        emulation)     cmd_emulation "$@" ;;
        server)        cmd_server "$@" ;;
        boot)          cmd_boot "$@" ;;
        ai)            cmd_ai "$@" ;;
        doctor)        cmd_doctor "$@" ;;
        support-bundle) cmd_support_bundle "$@" ;;
        repair-plan)   cmd_repair_plan "$@" ;;
        tune)          cmd_tune "$@" ;;
        capabilities|capability|features|recursos) cmd_capabilities "$@" ;;
        themes|temas) cmd_themes "$@" ;;
        deps|dependencias|dependências) cmd_deps "$@" ;;
        installation|installations) cmd_installation "$@" ;;
        self-update|selfupdate|update-phasezero) cmd_self_update "$@" ;;
        updates|app-updates|atualizacoes) cmd_updates "$@" ;;
        host|higiene)  cmd_host "$@" ;;
        uninstall|desinstalar|remove-all) exec "$PZ_ROOT/linux/uninstall.sh" "$@" ;;
        ui)            cmd_ui "$@" ;;
        commands)      cmd_commands "$@" ;;
        webapp|webapps) exec "$PZ_ROOT/linux/ui/webapp.sh" "$@" ;;
        games|jogos)   exec "$PZ_ROOT/linux/ui/games.sh" "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h|"") usage ;;
        *)             pz_error "unknown command: $cmd"; usage; return 1 ;;
    esac
}

main "$@"
