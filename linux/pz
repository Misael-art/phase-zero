cmd_version() {
    if [ -f "$PZ_ROOT/version.json" ]; then
        jq -r '"PhaseZero Linux v\(.version) (\(.channel))"' "$PZ_ROOT/version.json"
    else
        echo "PhaseZero Linux"
    fi
}

cmd_install() {
    local profile="" dry_run=0 arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run|-n) dry_run=1 ;;
            *) [ -z "$profile" ] && profile="$arg" ;;
        esac
    done
    [ -z "$profile" ] && { pz_error "usage: pz install <profile>"; return 1; }
    local profiles_dir="${PZ_PROFILES_DIR:-$PZ_ROOT/profiles}"
    local profile_file="$profiles_dir/$profile.json"
    if [ ! -f "$profile_file" ]; then
        # try looking up by naming convention
        profile_file=$(find "$profiles_dir" -maxdepth 1 -name "${profile}*" -type f 2>/dev/null | head -1)
        [ -z "$profile_file" ] && { pz_error "profile not found: $profile"; return 1; }
    fi
    pz_info "running profile: $profile ($profile_file)"
    if [ "$dry_run" = "1" ]; then
        PZ_DRY_RUN=1 pz_run_profile "$profile_file"
    else
        pz_run_profile "$profile_file"
    fi
}

cmd_flatpak() {
    bash "$PZ_ROOT/linux/flatpak/setup-remotes.sh" "$@"
}

cmd_steamdeck() {
    local action="${1:-}" target="${2:-}"
    [ -z "$action" ] && { pz_error "usage: pz steamdeck (handheld|docked-tv|docked-monitor|watch|keyboard|cursor|terminal-keyboard|panel|console|dev|hotkeys|watcher|privileged|boot|plugins|controller)"; return 1; }
    source "$PZ_ROOT/linux/steamdeck/common.sh"
    source "$PZ_ROOT/linux/steamdeck/input-actions.sh"
    case "$action" in
        handheld)     steamdeck_apply_handheld ;;
        docked-tv)    steamdeck_apply_docked_tv ;;
        docked-monitor) steamdeck_apply_docked_monitor ;;
        watch)        steamdeck_mode_watcher ;;
        detect)       steamdeck_detect_mode ;;
        keyboard|virtual-keyboard)
            case "${target:-toggle}" in
                toggle|"") steamdeck_toggle_virtual_keyboard ;;
                status) steamdeck_virtual_keyboard_status ;;
                configure|install|repair) steamdeck_configure_virtual_keyboard ;;
                revert|restore) steamdeck_revert_virtual_keyboard ;;
                *) pz_error "usage: pz steamdeck keyboard (toggle|status|configure|repair|revert)"; return 1 ;;
            esac
            ;;
        cursor|pointer)
            bash "$PZ_ROOT/linux/steamdeck/cursor-diagnose.sh" "${target:-snapshot}" "${3:-}"
            ;;
        terminal-keyboard)
            bash "$PZ_ROOT/linux/steamdeck/terminal-keyboard.sh" "${target:-watch}"
            ;;
        panel)
            bash "$PZ_ROOT/linux/steamdeck/install-deck-panel.sh" "${target:-status}"
            ;;
        console)      steamdeck_start_console_session "${target:-auto}" ;;
        dev|desktop)  steamdeck_start_dev_session "${target:-docked-monitor}" ;;
        hotkeys)      bash "$PZ_ROOT/linux/steamdeck/install-hotkeys.sh" "${target:-install}" ;;
        watcher)      bash "$PZ_ROOT/linux/steamdeck/install-mode-watcher.sh" "${target:-install}" ;;
        privileged)   bash "$PZ_ROOT/linux/steamdeck/install-privileged-controls.sh" "${target:-status}" ;;
        boot)         bash "$PZ_ROOT/linux/steamdeck/install-steamos-boot.sh" "${target:-status}" ;;
        plugins|decky|decky-plugins) bash "$PZ_ROOT/linux/steamdeck/plugins.sh" "${target:-status}" "${3:-}" "${4:-}" ;;
        runtime|runtime-diagnose|steam-runtime) bash "$PZ_ROOT/linux/steamdeck/steam-runtime-diagnose.sh" "${target:-diagnose}" "${3:-}" ;;
        status)       bash "$PZ_ROOT/linux/steamdeck/status.sh" ;;
        launch-options) bash "$PZ_ROOT/linux/steamdeck/launch-options.sh" "${target:-list}" "${3:-balanced}" ;;
        conveniences|convenience|launchers) bash "$PZ_ROOT/linux/steamdeck/convenience-launchers.sh" "${target:-status}" ;;
        removable|removable-mount|usb-mount) bash "$PZ_ROOT/linux/steamdeck/install-removable-mount.sh" "${target:-status}" ;;
        display)       bash "$PZ_ROOT/linux/steamdeck/display-session.sh" "${target:-status}" ;;
        controller|controller-desktop) bash "$PZ_ROOT/linux/steamdeck/controller-desktop.sh" "${target:-status}" ;;
        ux)           bash "$PZ_ROOT/linux/steamdeck/install-hotkeys.sh" "${target:-install}" ;;
        *)            pz_error "unknown steamdeck mode: $action"; return 1 ;;
    esac
}

cmd_emulation() {
    local action="${1:-status}" target="${2:-}"
    shift 2 2>/dev/null || true
    local extra=("$@")
    local has_json=false
    local e
    for e in "${extra[@]}"; do [ "$e" = "--json" ] && has_json=true; done
    case "$action" in
        layout)       bash "$PZ_ROOT/linux/emulation/bios.sh" layout "${extra[@]}" ;;
        status)       bash "$PZ_ROOT/linux/emulation/bios.sh" status "${extra[@]}" ;;
        blocked-sources|policy) bash "$PZ_ROOT/linux/emulation/bios.sh" blocked-sources "${extra[@]}" ;;
