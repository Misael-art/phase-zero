{
  "schema": "https://phasezero.local/schemas/profile.json",
  "name": "gaming",
  "description": "Gaming setup: Steam, emulators, performance tools",
  "os": ["linux", "windows"],
  "packages": {
    "linux": {
      "archRepos": ["multilib"],
      "pacman": [
        "steam",
        "steam-devices",
        "gamescope",
        "mangohud",
        "gamemode",
        "lutris",
        "wine",
        "winetricks",
        "protontricks",
        "git",
        "git-lfs",
        "github-cli",
        "lib32-mangohud",
        "lib32-gamemode",
        "vulkan-radeon",
        "lib32-vulkan-radeon",
        "vulkan-tools",
        "corectrl",
        "discord",
        "obs-studio",
        "goverlay"
      ],
      "optionalPacman": [
        "gamescope-dbus"
      ],
      "yay": [
        "ryzenadj",
        "heroic-games-launcher-bin",
        "proton-ge-custom-bin",
        "ananicy-git"
      ],
      "flatpak": {
        "remotes": [
          {
            "name": "flathub",
            "url": "https://dl.flathub.org/repo/flathub.flatpakrepo",
            "required": true
          },
          {
            "name": "flathub-beta",
            "url": "https://flathub.org/beta-repo/flathub-beta.flatpakrepo",
            "required": false
          }
        ],
        "overrides": {
          "gaming": true
        },
        "packages": [
          "org.freedesktop.Platform.Compat.i386",
          "org.freedesktop.Platform.GL32.default"
        ]
      }
    },
    "windows": {
      "winget": ["Valve.Steam"],
      "choco": ["steam", "discord"]
    }
  },
  "scripts": {
    "linux": [
      "linux/tuning/git-config.sh",
      "linux/tuning/gaming-tweaks.sh"
    ],
    "windows": []
  },
  "configs": {
    "linux": []
  },
  "systemd": {
    "linux": {
      "enable": ["ananicy", "gamemoded"],
      "user": []
    }
  },
  "tuning": {
    "linux": {
      "sysctl": {
        "vm.max_map_count": 2147483642,
        "kernel.nmi_watchdog": 0
      }
    }
  }
}
